# Server
PORT=3000

# Ollama - local inference. Pull both models before first run:
#   ollama pull llama3.2:1b
#   ollama pull nomic-embed-text
#
# llama3.2:1b answers in roughly 8s on a mid-range CPU. llama3:latest gives
# better synthesis on broad questions but takes ~40s to the first token.
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.2:1b
EMBED_MODEL=nomic-embed-text

# Supabase Postgres (pgvector). Use the connection pooler string from
# Supabase > Project Settings > Database > Connection pooling.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Chunking - measured in real tokens (cl100k_base), not words. Small chunks are
# the main speed lever: prompt prefill runs at roughly 90-240 tok/s on CPU, so
# every token of retrieved context is paid for before the first answer token.
CHUNK_TOKENS=220
CHUNK_OVERLAP_TOKENS=40

# Retrieval.
#   MIN_SCORE is an absolute floor and must stay low. Cosine values are
#   corpus-dependent - genuine matches top out near 0.77 on one site and 0.53
#   on another - so a high floor silently blocks every result on some corpora.
#   RELATIVE_CUTOFF keeps chunks within this fraction of the best hit.
#   MAX_TOKENS caps the context and therefore the response time.
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_RELATIVE_CUTOFF=0.82
RETRIEVAL_MAX_TOKENS=600

# Relevance gate. Similarity alone cannot reject an off-topic question: a
# nonsense query sharing one topical noun still scores ~0.60 against a corpus
# whose genuine answers score ~0.65. This requires that a fraction of the
# question's content words actually appear in the retrieved text.
# Lower it if legitimate paraphrases are being refused.
GROUNDING_MIN_TERM_RATIO=0.5

# Context window, set explicitly so behaviour never depends on the Ollama
# default. Left unset, an oversized prompt is silently truncated and the model
# loses the retrieved context.
OLLAMA_NUM_CTX=2048

# Caps answer length. Small local models pad past the context without this.
ANSWER_MAX_TOKENS=160

# Must match the embedding model's output width (nomic-embed-text = 768).
# Changing this requires a schema migration, since the vector column is typed.
EMBED_DIMENSIONS=768

# Crawling. Heavy pages can need more than 30s to reach network idle, and a
# timeout there costs the whole site rather than one page.
PAGE_TIMEOUT_MS=45000

# Optional hard cap on chunks per site. Page count is a poor proxy for cost:
# one documentation page can yield 150 chunks while a marketing page yields 3.
# 0 disables the cap.
MAX_CHUNKS_PER_SITE=0

# Postgres pool size. The Supabase pooler is the bottleneck, not this.
PG_POOL_MAX=5
